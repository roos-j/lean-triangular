lemma Jbar_integrable (hh : 0 < Hd.h) {η : ℝ} (hη : 0 < η) {α : Fin 3 → ℝ} (hα1 : ∀ k, 1 ≤ α k)
    (hα2 : ∀ k, α k ≤ 2) {s : ℝ} (hs : 0 < s) :
    Integrable (fun p => Gm (1 / 10) 0 s p * ∑ v, Hd.qE α η v s p) := by
